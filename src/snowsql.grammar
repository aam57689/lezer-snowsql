AlterSessionAction {

  Set PropsList |
  Unset KeyNameList |
  GenericCommandTail

}


AlterWarehouseAction {

  Suspend |
  Resume (If Suspended)? |
  Enable |
  Disable |
  Abort All Queries |
  Rename To ObjName |
  Set PropsList |
  Set Tag TagValuePairsList |
  Unset Tag TagNamesList |
  Unset KeyNameList |
  GenericCommandTail

}


AlterTableAction {

  Rename To ObjName |
  Swap With ObjName |
  Set PropsList |
  Set Tag TagValuePairsList |
  Unset Tag TagNamesList |
  Unset KeyNameList |
  Cluster By Lparen ScalarExpression (Comma ScalarExpression)* Rparen |
  Add Column? IfNotExists? ColumnDef |
  Rename Column IdentifierExt To IdentifierExt |
  Drop Column? IfExists? ColumnNameOnlyList |
  (Alter | Modify) Column? AlterColumnDefinition |
  GenericCommandTail

}


AlterViewAction {

  Rename To ObjName |
  Set (Comment Eql StringLiteral | Secure) |
  Unset Comment |
  GenericCommandTail

}


AlterTaskAction {

  Suspend |
  Resume |
  Set PropsList |
  Unset KeyNameList |
  GenericCommandTail

}


AlterObjectAction {

  Rename To ObjName |
  Set PropsList |
  Set Tag TagValuePairsList |
  Unset Tag TagNamesList |
  Unset KeyNameList |
  Suspend |
  Resume |
  GenericCommandTail

}


ColumnDef {

  IdentifierExt Types ColumnDefOption*

}


ColumnDefOption {

  Default ScalarExpression |
  Not Null |
  CommentClause |
  Collate StringLiteral |
  Autoincrement |
  Identity |
  InlineTableConstraint

}


InlineTableConstraint {

  (Constraint IdentifierExt)?
  (
    Unique |
    Primary Key |
    References ObjName (Lparen IdentifierExt Rparen)?
  )
  TableConstraintProperties*

}


AlterColumnDefinition {

  Lparen AlterColumnSpec (Comma AlterColumnSpec)* Rparen |
  AlterColumnSpec

}


AlterColumnSpec {

  Column? IdentifierExt AlterColumnAction

}


AlterColumnAction {

  Drop Default |
  Set Default ScalarExpression |
  Set? Not Null |
  Drop Not Null |
  Comment StringLiteral |
  Unset Comment |
  Type? Types

}


SnowflakeObjectType {

  GenericCreateObjectType |
  GenericAlterObjectType |
  Account |
  Database |
  External? Table |
  Function |
  Managed Account |
  Materialized? View |
  Procedure |
  Resource Monitor |
  Role |
  Schema |
  Share |
  Stream |
  Task

}


GenericCommandTail {

  GenericCommandAtom+

}


GenericCommandAtom {

  IdentifierExt |
  GenericCommandKeyword |
  StringLiteral |
  NumberLiteral |
  IntegerLiteral |
  BooleanValue |
  BindVariable |
  URLIdentifier |
  Lparen GenericCommandTail? Rparen |
  Lsqr GenericCommandTail? Rsqr |
  Eql |
  Darw |
  Comma |
  Dot |
  Star |
  Plus |
  Minus |
  Divide |
  Mod |
  Colon |
  Dcolon |
  Arr |
  Gtr |
  Lss |
  Gte |
  Lte |
  Neq

}


