  Without

}


AlterTaskStmt {


  Alter Task IfExists? ObjName (Suspend | Resume) 

}


TimeTravelClause {

  (At | Before)? Lparen (Timestamp | Offset | Statement) Darw ScalarExpression Rparen

}


ShowInClause {

  In Account |
  In (Schema | Database)? ObjName 

}


ShowLimitClause  {

  Limit IntegerLiteral (From StringLiteral)?

}


ShowStmt {

  Show Terse? ShowObjectType ShowQualifier* |

  Show Grants ShowGrantScope? |

  Show Parameters ShowQualifier* |

  Show Columns ShowQualifier*

}


ShowQualifier {

  History |
  Like StringLiteral |
  ShowInClause |
  Starts With StringLiteral |
  ShowLimitClause |
  For ObjName |
  On ObjName |
  In SnowflakeObjectType ObjName |
  GenericCommandTail

}


ShowGrantScope {

  On SnowflakeObjectType ObjName |
  To (Role | Database Role | Application Role | User | Share | Application) ObjName |
  Of (Role | Database Role | Application Role | User | Share | Application) ObjName |
  By (Role | Database Role | Application Role | User | Share | Application) ObjName |
  In (Account | Database ObjName | Schema ObjName | Application ObjName)

}


