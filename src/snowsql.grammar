@top SnowSQL {
  
  Stmts

}


@precedence {

  uminus @right,
  pow @left,
  mul @left,
  plus @left,
  is,
  isnull,
  notnull,
  arb,
  in,
  between,
  escape,
  any,
  like,
  regexp,
  comp @left,
  eql @left,
  bitOr @left,
  bitXor @left,
  bitAnd @left,
  not @right,
  and @left,
  or @left,
  intersect @left,
  union @left
  
}


Stmts {

  (Stmt (Smc+ Stmt)*)? Smc* 

}


Stmt {

  SelectStmt |
  DescribeStmt | 
  DropStmt |
  InsertStmt |
  CreateManagedAccount |
  CreateStmt |
  CreateStreamStmt |
  CreateMaterializedView |
  CreateResourceMonitor |
  CreateRowAccessPolicy |
  CreateIntegrationStmt |
  CreateViewStmt |
  CreatePipeStmt |
  CreateTaskStmt |
  CommitStmt |
  RollbackStmt |
  TruncateStmt |
  UseStmt |
  GrantRoleStmt |
  GrantPrivilegesStmt |
  GrantExtendedStmt |
  CreateTableStmt |
  CreateFunctionStmt |
  CreateProcedureStmt |
  CreateSchema |
  CreateMaskingPolicy |
  CreateGenericObjectStmt |
  AlterStmt |
  CallStmt |
  DeleteStmt |
  UpdateStmt |
  MergeStmt |
  SetStmt |
  UnsetStmt |
  BeginStmt |
  CommentStmt |
  RevokeRoleStmt |
  RevokePrivilegesStmt |
  ExecuteStmt |
  ExplainStmt |
  CopyFilesStmt |
  GetStmt |
  PutStmt |
  ListStmt |
  RemoveStmt |
  ShowStmt |
  CopyStmt |
  UndropStmt

}


DropStmt {

  Drop DropTargetSimple ObjName |
  
  Drop (Function | Procedure) ObjName UdfTypeSig |

  Drop DropTargetWithIfExists IfExists? ObjName |

  Drop DropTargetAdditional IfExists? ObjName DropOptions? |

  Drop DropTargetWithOptions IfExists? ObjName DropOptions?

}


DropTargetSimple {

  Share |
  Resource Monitor |
  Managed Account |
  Masking Policy

}


DropTargetWithIfExists {

  Connection |
  File Format |
  (Row Access | Network | Session) Policy |
  Materialized? View |
  Pipe |
  Tag |
  Task |
  User |
  Stream |
  Stage |
  Role |
  (API | Notification | Security | Storage)? Integration |
  Warehouse

}


DropTargetWithOptions {

  Database |
  External? Table |
  Sequence |
  Schema 
  
}


DropTargetAdditional {

  Account |
  Agent |
  Aggregation Policy |
  Alert |
  Application |
  Application Package |
  Application Role |
  Authentication Policy |
  Backup Policy |
  Backup Set |
  Catalog Integration |
  Compute Pool |
  Contact |
  Cortex Search Service |
  Database Role |
  Dataset |
  Dbt Project |
  DCM Project |
  Dynamic Table |
  Event Table |
  Experiment |
  External Agent |
  External Access Integration |
  External Volume |
  Failover Group |
  Feature Policy |
  Gateway |
  Git Repository |
  Hybrid Table |
  Iceberg Table |
  Image Repository |
  Index |
  Interactive Table |
  Join Policy |
  Listing |
  Maintenance Policy |
  MCP Server |
  Model |
  Model Monitor |
  Network Rule |
  Notebook |
  Online Feature Table |
  Organization Profile |
  Organization User |
  Organization User Group |
  Packages Policy |
  Password Policy |
  Postgres Instance |
  Privacy Policy |
  Projection Policy |
  Replication Group |
  Secret |
  Semantic View |
  Service |
  Session Policy |
  Snapshot |
  Snapshot Policy |
  Snapshot Set |
  Storage Lifecycle Policy |
  Streamlit |
  Type

}


GrantPrivilegesStmt {

  Grant (PrivilegePrefix PrivilegeSuffix?) (Comma PrivilegePrefix PrivilegeSuffix?)* 

  On PrivilegeObj To (Share | Role)? ObjName (With Grant Option)? ((Revoke| Copy) Current Grants)? | 

  Grant Imported Privileges On PrivilegeObj To (Share | Role)? ObjName

}


GrantRoleStmt {

  Grant Role ObjName (Comma ObjName)* To (Role | User) ObjName

}


PrivilegeObjectTypePlural  {

  Tables |
  External Tables |
  Views |
  Materialized Views |
  Masking Policies |
  Row Access Policies |
  Sequences |
  Functions |
  Procedures |
  File Formats |
  Stages |
  Schemas |
  Pipes |
  Streams |
  Tasks |
  Integrations |
  Databases

}


PrivilegeObjectType {

  Table |
  Schema |
  Database|
  External Table |
  View |
  Integration |
  Materialized View |
  Masking Policy |
  Row Access Policy |
  Sequence |
  Function |
  Procedure |
  File Format |
  Stage |
  Pipe |
  Stream |
  Task 

}


PrivilegeObj {

  Account |
  System |
  PrivilegeObjectType (ObjName UdfTypeSig | ObjName) |
  ObjName |
  All PrivilegeObjectTypePlural In (Schema | Database ) ObjName |
  Future PrivilegeObjectTypePlural In ( Schema | Database ) ObjName

}


CreateStmt  {

  Create Account Identifier Admin_name Eql Identifier Admin_password Eql StringLiteral (First_name Eql Identifier)? (Last_name Eql Identifier)?
  Email Eql EmailAddr (Must_change_password Eql (True | False))? Edition Eql (Standard | Enterprise | Business_critical) AccountOptional |

  //create clone
  Create OptOrReplace? (Stage | File Format | Sequence) IfNotExists? Identifier Clone Identifier |

  //create database
  Create OptOrReplace? (Transient)? Database IfNotExists? Identifier  
  (Clone Identifier ((At | Before) ((Timestamp Eql Identifier | Offset Eql Identifier | Statement Eql Identifier)))?)? DbOp  | 

  Create Database Identifier From Share Identifier Dot Identifier |


  Create Database Identifier As Replica Of Identifier Dot Identifier
  Auto_refresh_materialized_views_on_secondary Eql (True | False) |

  //create network policy
  Create  Network  Policy  Identifier  Allowed_IP_List Eql Lparen Sqt IpA Sqt (Comma Sqt IpA Sqt)* Rparen  
  (Blocked_IP_List Eql Lparen  Sqt IpA Sqt (Comma Sqt IpA Sqt)* Rparen)? |

  //Create Role
  Create OptOrReplace? Role IfNotExists? Identifier (Comment Eql StringLiteral)? |

  //Create share
  Create OptOrReplace? Share Identifier (Comment Eql StringLiteral)? 

}


CreateStreamStmt {

  Create OptOrReplace? Stream IfNotExists? ObjName 
  
  ((Copy Grants)? On (External? Table ObjName) TimeTravelClause? | 

  CloneDefintion (Copy Grants)?)? PropsList?
  
}


CloneDefintion {

  Clone IfExists? ObjName TimeTravelClause?

}


UseStmt {

  Use ObjName | 
  Use Schema ObjName | 
  Use Database ObjName | 
  Use Warehouse ObjName |
  Use Role ObjName |
  Use Secondary Roles (All | None)

}


BeginStmt {

  Begin (Work | Transaction)?

}


CallStmt {

  Call ObjName Lparen CallArgList? Rparen (Into BindVariable)?

}


CallArgList {

  CallArg (Comma CallArg)*

}


CallArg {

  (IdentifierExt Darw)? (ScalarExpression | QueryStatementExpression)

}


SetStmt {

  Set SetAssignment |
  Set Lparen SetVariableList Rparen Eql Lparen SetExpressionList Rparen

}


SetAssignment {

  SetVariable Eql ScalarExpression

}


SetVariableList {

  SetVariable (Comma SetVariable)*

}


SetVariable {

  IdentifierExt |
  SessionVariableIdentifier

}


SetExpressionList {

  ScalarExpression (Comma ScalarExpression)*

}


UnsetStmt {

  Unset SetVariable |
  Unset Lparen SetVariableList Rparen

}


DeleteStmt {

  Delete From ObjName DeleteUsingClause? WhereClause?

}


DeleteUsingClause {

  Using DeleteUsingSource (Comma DeleteUsingSource)*

}


DeleteUsingSource {

  ObjName AliasClause? |
  ParenSelect AliasClause?

}


UpdateStmt {

  Update ObjName AliasClause?
  Set UpdateAssignmentList
  UpdateFromClause?
  WhereClause?

}


UpdateAssignmentList {

  UpdateAssignment (Comma UpdateAssignment)*

}


UpdateAssignment {

  AssignmentTarget Eql ScalarExpression

}


UpdateFromClause {

  From FromExpression (Comma FromExpression)*

}


MergeStmt {

  Merge Into ObjName AliasClause?
  Using MergeSource
  On ScalarExpression
  MergeClause+

}


MergeSource {

  ObjName AliasClause? |
  ParenSelect AliasClause?

}


MergeClause {

  MergeMatchedClause |
  MergeNotMatchedClause

}


MergeMatchedClause {

  When Matched (And ScalarExpression)?
  Then (MergeUpdateClause | Delete)

}


MergeNotMatchedClause {

  When Not Matched (And ScalarExpression)?
  Then MergeInsertClause

}


MergeUpdateClause {

  Update (All By Name | Set MergeAssignmentList)

}


MergeAssignmentList {

  MergeAssignment (Comma MergeAssignment)*

}


MergeAssignment {

  AssignmentTarget Eql ScalarExpression

}


AssignmentTarget {

  IdentifierExt (Dot IdentifierExt)*

}


MergeInsertClause {

  Insert (
    All By Name |
    (Lparen ColumnNameList Rparen)? Values ValueList
  )

}


GrantExtendedStmt {

  Grant Database Role ObjName (Comma ObjName)* To (Role | Database Role | User | Share) ObjName |
  Grant Application Role ObjName (Comma ObjName)* To (Role | Application Role | Application | User) ObjName |
  Grant Service Role ObjName (Comma ObjName)* To (Role | Application Role | Database Role) ObjName |
  Grant Caller GenericCommandTail

}


RevokeRoleStmt {

  Revoke Role ObjName (Comma ObjName)* From (Role | User) ObjName |
  Revoke Database Role ObjName (Comma ObjName)* From (Role | Database Role | User | Share) ObjName |
  Revoke Application Role ObjName (Comma ObjName)* From (Role | Application Role | Application | User) ObjName |
  Revoke Service Role ObjName (Comma ObjName)* From (Role | Application Role | Database Role) ObjName |
  Revoke Caller GenericCommandTail

}


RevokePrivilegesStmt {

  Revoke (Grant Option For)?
  (PrivilegePrefix PrivilegeSuffix?) (Comma PrivilegePrefix PrivilegeSuffix?)*
  On PrivilegeObj From (Share | Role | User | Application | Application Role)? ObjName DropOptions?

}


CommentStmt {

  Comment On SnowflakeObjectType ObjName Is (StringLiteral | Null)

}


ExplainStmt {

  Explain (Using (Text | Tabular | Json))? Stmt

}


ExecuteStmt {

  Execute Immediate ExecuteImmediateTarget (Using Lparen SetExpressionList Rparen)? |
  Execute Immediate From URLDefinition GenericCommandTail? |
  Execute (Alert | Task | Notebook | Notebook Project | Dbt Project | DCM Project | Job Service) ObjName GenericCommandTail?

}


ExecuteImmediateTarget {

  StringLiteral |
  BindVariable |
  SessionVariableIdentifier |
  ObjName

}


CopyFilesStmt {

  Copy Files Into URLDefinition From URLDefinition GenericCommandTail?

}


PutStmt {

  Put URLDefinition URLDefinition WithProvision?

}


ListStmt {

  List URLDefinition (Pattern Eql StringLiteral)?

}


RemoveStmt {

  Remove URLDefinition (Pattern Eql StringLiteral)?

}


UndropStmt {

  Undrop UndropTarget ObjName

}


UndropTarget {

  Account |
  Database |
  Dynamic Table |
  External Volume |
  Iceberg Table |
  Notebook |
  Schema |
  Snapshot |
  Streamlit |
  Table |
  Tag |
  Type

}


CreateGenericObjectStmt {

  Create (Or Alter)? OptOrReplace? GenericCreateObjectType IfNotExists? ObjName CreateGenericClause*

}


CreateGenericClause {

  CloneProvision |
  As QueryStatementExpression |
  As StringLiteral |
  From ObjName |
  From URLDefinition |
  On ObjName |
  WithProvision |
  GenericCommandTail

}


