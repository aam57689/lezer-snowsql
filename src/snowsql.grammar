  Trim_space Eql True | False
  Null_if Eql (Identifier  (Comma Identifier )*)

}


FormattypeoptionsOrc {

  Trim_space Eql True | False
  Null_if Eql (Identifier  (Comma Identifier )*)

}


FormattypeoptionsParquet {

